{
  "expo": {
    "name": "CASSATE BAND RECORDZ",
    "slug": "cassate-band-recordz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cassate_logo.png",
    "scheme": "cassatebandrecordz",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/cassate_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0813"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.cassatebandrecordz.studio",
      "adaptiveIcon": {
        "backgroundColor": "#0A0813",
        "foregroundImage": "./assets/images/cassate_logo.png"
      },
      "splash": {
        "backgroundColor": "#0A0813",
        "image": "./assets/images/cassate_logo.png",
        "resizeMode": "contain"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "updates": {
      "url": "https://u.expo.dev/3c2e67ea-d321-47df-aa52-5c0eb2c9b541",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3c2e67ea-d321-47df-aa52-5c0eb2c9b541"
      }
    }
  }
}
