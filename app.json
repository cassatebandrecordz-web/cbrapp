{
  "expo": {
    "name": "CASSATE BAND RECORDZ",
    "slug": "cassate-band-recordz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cassatebandrecordz",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.cassatebandrecordz.studio",
      "adaptiveIcon": {
        "backgroundColor": "#0A0813",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0813",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-asset"
    ],
    "updates": {
      "url": "https://u.expo.dev/3c2e67ea-d321-47df-aa52-5c0eb2c9b541",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3c2e67ea-d321-47df-aa52-5c0eb2c9b541"
      }
    }
  }
}
